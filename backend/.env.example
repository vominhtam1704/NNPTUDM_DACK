# ===== ENVIRONMENT =====
NODE_ENV=development
PORT=5000

# ===== CORS & SECURITY =====
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== MONGODB CONNECTION =====
MONGODB_URI=mongodb://localhost:27017/barber_atelier
MONGODB_USER=admin
MONGODB_PASSWORD=your-secure-password

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ===== BCRYPT =====
SALT_ROUNDS=10

# ===== FILE UPLOAD =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ===== SEPAY PAYMENT GATEWAY =====
SEPAY_ACCOUNT_NUMBER=your-account-number
SEPAY_ACCOUNT_NAME=Your Business Name
SEPAY_BANK_CODE=MBBank
SEPAY_API_BASE=https://api.sepay.vn
WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key

# ===== EMAIL (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== LOGGING =====
LOG_LEVEL=debug
